# Server
PROXMOX_MCP_ENVIRONMENT=homelab
PROXMOX_MCP_SERVER_HOST=0.0.0.0
PROXMOX_MCP_SERVER_PORT=8443
PROXMOX_MCP_LOG_LEVEL=info

# Runtime
PROXMOX_MCP_DURABLE_STATE_ENABLED=true
PROXMOX_MCP_EXTERNAL_AUTH_ENABLED=true

# Auth (homelab service token)
PROXMOX_MCP_AUTH_MODE=service_token
PROXMOX_MCP_SERVICE_TOKEN=replace-with-long-random-token
# Least-privilege default for the shared primary token actor (read_only|operator|…).
# cluster_admin/administrator on the shared token requires:
#   PROXMOX_MCP_ALLOW_SHARED_SERVICE_TOKEN_ELEVATED_ROLE=true
PROXMOX_MCP_MCP_SERVICE_ROLE=read_only
# Prefer distinct per-token actors in production:
# PROXMOX_MCP_SERVICE_TOKEN_ACTORS=[{"token_sha256":"…","user_id":"…","agent_id":"…","role":"operator"}]
PROXMOX_MCP_DEFAULT_ACTOR__USER_ID=operator
PROXMOX_MCP_DEFAULT_ACTOR__AGENT_ID=homelab-agent

# Admin control plane (https://localhost:8443/admin)
PROXMOX_MCP_ADMIN_USERNAME=admin
PROXMOX_MCP_ADMIN_PASSWORD=replace-with-strong-admin-password
PROXMOX_MCP_ADMIN_SPA_DIR=web/dist
PROXMOX_MCP_ENV_FILE=.env

# TLS — HTTPS always (local included). Pick ONE mode:
#
# Generate (homelab / first boot): creates cert+key+ca.crt under generated_cert_dir
#   proxmox-mcp tls generate --out-dir ./certs/local
#   PROXMOX_MCP_TLS__MODE=generate
#   PROXMOX_MCP_TLS__GENERATE_SELF_SIGNED=true
#   # Import ./certs/local/ca.crt into browsers / MCP clients for verified HTTPS
#
# BYOC (bring your own cert / operator CA):
PROXMOX_MCP_TLS__MODE=byoc
PROXMOX_MCP_TLS__CERT_FILE=./certs/local/tls.crt
PROXMOX_MCP_TLS__KEY_FILE=./certs/local/tls.key
# Optional: operator CA for client trust + chain validation
# PROXMOX_MCP_TLS__CA_FILE=./certs/local/ca.crt
PROXMOX_MCP_TLS__GENERATE_SELF_SIGNED=false
# Production rejects generate mode unless:
# PROXMOX_MCP_ALLOW_GENERATED_TLS=true
#
# Generate a leaf signed by your existing CA:
#   proxmox-mcp tls generate --out-dir ./certs/local \
#     --ca-cert ./certs/my-ca.crt --ca-key ./certs/my-ca.key \
#     --cn mcp.home.arpa --san mcp.home.arpa --san 192.168.1.10

# Database
PROXMOX_MCP_DATABASE_URL=postgresql+asyncpg://proxmox_mcp:change-me@localhost:5432/proxmox_mcp?ssl=require
PROXMOX_MCP_POSTGRES_PASSWORD=change-me

# Redis
PROXMOX_MCP_REDIS_URL=rediss://localhost:6379/0

# Secrets
PROXMOX_MCP_CREDENTIAL_PROVIDER=development
PROXMOX_MCP_SECRETS_FILE=./secrets.local.json

# Multi-host catalog (Admin UI switcher; optional for single-host homelab)
PROXMOX_MCP_HOSTS_FILE=./hosts.local.json
# Set after switching hosts in Admin, or leave unset to use catalog active_host_id
# PROXMOX_MCP_ACTIVE_HOST_ID=homelab

# Proxmox cluster
PROXMOX_MCP_CLUSTER__CLUSTER_ID=homelab
PROXMOX_MCP_CLUSTER__NAME=Homelab Proxmox
PROXMOX_MCP_CLUSTER__API_ENDPOINT=https://pve.example.test:8006
PROXMOX_MCP_CLUSTER__TLS_VERIFY=true
PROXMOX_MCP_CLUSTER__ENVIRONMENT=homelab
PROXMOX_MCP_CLUSTER__CREDENTIAL_REF__PROVIDER=development
PROXMOX_MCP_CLUSTER__CREDENTIAL_REF__PATH=clusters/homelab/proxmox-api
PROXMOX_MCP_CLUSTER__CREDENTIAL_REF__PURPOSE=proxmox_api

# Observability (optional)
# PROXMOX_MCP_OBSERVABILITY__PROMETHEUS_URL=https://prometheus.example.test
# PROXMOX_MCP_OBSERVABILITY__ALERTMANAGER_URL=https://alertmanager.example.test

# Lab gates (optional, never commit real credentials)
# PROXMOX_MCP_LAB_ENABLED=true
# PROXMOX_MCP_LAB_API_ENDPOINT=https://pve.example.test:8006
